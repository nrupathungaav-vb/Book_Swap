# =============================================================================
# BookSwap environment variables
# Copy to .env.local for local development (never commit .env.local).
# On Vercel, add these under Project → Settings → Environment Variables.
# =============================================================================

# --- PUBLIC (exposed to the browser; safe by design) -------------------------
# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API → anon / publishable key (RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Absolute URL of the app, used for OAuth/email redirects (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- SERVER-ONLY (never prefix with NEXT_PUBLIC_) ------------------------------
# Supabase → Project Settings → API → service_role key. BYPASSES RLS.
# Not used by the running app. Only the Playwright E2E setup uses it (to create
# pre-confirmed test users). Never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio → https://aistudio.google.com/apikey  (required for AI insights)
GEMINI_API_KEY=
# Optional model override
GEMINI_MODEL=gemini-2.5-flash

# Google Cloud Console → APIs & Services → Credentials → API key with
# "Books API" enabled. Optional: Google Books works without a key at low volume.
GOOGLE_BOOKS_API_KEY=
